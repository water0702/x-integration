<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://authorizationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="authorizationDc"
                  class="com.x.integration.domain.model.authorization.Authorization">
            <fetchPlan extends="_base">
                <property name="interfaces" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
            <collection id="interfacesDc" property="interfaces"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="authorizationDc">
            <textField id="nameField" property="name"/>
            <textField id="descriptionField" property="description"/>
            <textField id="protocolField" property="protocol"/>
            <textField id="hostField" property="host"/>
            <textField id="portField" property="port"/>
            <textField id="pathField" property="path"/>
            <textField id="clientIdField" property="clientId"/>
            <passwordField id="clientSecretField" property="clientSecret"/>
        </formLayout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button action="interfacesDataGrid.create"/>
            <button action="interfacesDataGrid.edit"/>
            <button action="interfacesDataGrid.remove"/>
        </hbox>
        <dataGrid id="interfacesDataGrid" dataContainer="interfacesDc" width="100%" height="15em">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns>
                <column property="name"/>
                <column property="description"/>
                <column property="path"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
