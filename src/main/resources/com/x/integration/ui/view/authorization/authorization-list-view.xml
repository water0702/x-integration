<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://authorizationListView.title"
      focusComponent="authorizationsDataGrid">
    <data readOnly="true">
        <collection id="authorizationsDc"
                    class="com.x.integration.domain.model.authorization.Authorization">
            <fetchPlan extends="_base"/>
            <loader id="authorizationsDl">
                <query>
                    <![CDATA[select e from INTEG_Authorization e]]>
                </query>
            </loader>
            <collection id="interfacesDc" property="interfaces"></collection>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="authorizationsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" action="authorizationsDataGrid.create"/>
            <button id="editBtn" action="authorizationsDataGrid.edit"/>
            <button id="removeBtn" action="authorizationsDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="authorizationsDl" itemsPerPageVisible="true"/>
        </hbox>
        <split width="100%" height="100%" orientation="VERTICAL" themeNames="minimal">
            <dataGrid id="authorizationsDataGrid"
                      width="100%"
                      height="100%"
                      dataContainer="authorizationsDc">
                <actions>
                    <action id="create" type="list_create">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="edit" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns>
                    <column property="name"/>
                    <column property="description"/>
                    <column property="protocol"/>
                    <column property="host"/>
                    <column property="port"/>
                    <column property="path"/>
                    <column property="clientId"/>
                </columns>
            </dataGrid>
            <dataGrid id="interfacesDataGrid" dataContainer="interfacesDc" width="100%" height="100%">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns>
                    <column property="name"/>
                    <column property="description"/>
                    <column property="path"/>
                </columns>
            </dataGrid>
        </split>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
